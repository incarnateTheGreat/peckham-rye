# Copy this file to .env and fill in your actual values for local testing
# WARNING: Never commit .env to git!
#
# track_jobs.py calls load_dotenv() at import, so .env is picked up
# automatically by the tracker, dashboard, migration and update scripts.
# Real environment variables take precedence, so this is inert in CI.

# NeonDB connection string. Required by every script that touches state.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Default webhook, used when no profile-specific webhook is set.
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Per-profile webhooks. A profile named "product-owner" looks for
# DISCORD_WEBHOOK_PRODUCT_OWNER first, then falls back to DISCORD_WEBHOOK_URL.
# A profile may also name its own env var via the `webhook_env` field.
# DISCORD_WEBHOOK_ENGINEERING=
# DISCORD_WEBHOOK_PRODUCT_OWNER=
